# Upstash Redis REST API (Chọn 1 trong 2 cách đặt tên bên dưới)
# Cách 1: Khi kết nối Upstash qua Vercel Marketplace (Vercel tự điền)
KV_REST_API_URL="https://your-upstash-redis-url.upstash.io"
KV_REST_API_TOKEN="your-upstash-redis-token"

# Cách 2: Khi tạo trực tiếp trên console.upstash.com và tự thêm vào Vercel
UPSTASH_REDIS_REST_URL="https://frank-catfish-231783.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAA4lnAAIgcDI5M2E4NDE3MjZhOTc0ZmMzYjMxMDVkOTk4NDU1YmM2MA"

# Chạy thử ở máy: Đặt USE_LOCAL_REDIS=true để dùng Redis trong RAM (0ms, không phụ thuộc mạng, không lo timeout)
USE_LOCAL_REDIS=true

# Mật khẩu quản trị trang /admin.html (dùng để xem thống kê, in mã QR trạm & cổng)
ADMIN_KEY="dât_mat_khau_admin_dai_va_kho_doan_tai_day"

# Mật khẩu nhân sự sự kiện trang /staff.html (dùng để quét QR đóng dấu, trao quà)
STAFF_KEY="dat_mat_khau_nhan_su_tai_day"

